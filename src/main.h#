mod cmd_env is

    pub fn run(sub: string, yes: bool) -> bool is
        if sub == "activate"   is return activate(yes) end
        if sub == "deactivate" is return deactivate(yes) end
        if sub == "status"     is return status() end
        output::error("unknown env subcommand '" + sub + "' \xe2\x80\x94 use activate | deactivate | status")
        return false
    end

    fn activate(yes: bool) -> bool is
        output::header("Activate HNM profile")

        let profile: string = config::profile_dir()
        let bin_dir: string = path::join(profile, "bin")

        if yes is
            output::info("patching shell rc files (~/.bashrc, ~/.zshrc, ~/.profile)...")
            write("")
            let patched: [string] = shellrc::patch(bin_dir)
            write("")
            if patched.len() == 0 is
                output::info("nothing to patch \xe2\x80\x94 already activated, or no rc files found")
            else is
                output::ok("patched: " + str::join(patched, ", "))
                output::dim("Reload your shell (or open a new terminal) to apply.")
            end
            return true
        end

        output::info("Add the following to your ~/.bashrc or ~/.zshrc:")
        write("")
        write("  # HNM + Nix")
        write("  export PATH=\"" + bin_dir + ":$PATH\"")

        let nix_sh: string = shellrc::find_nix_sh()
        if nix_sh != "" is
            write("  [ -f '" + nix_sh + "' ] && . '" + nix_sh + "'")
        else is
            write("  [ -f ~/.nix-profile/etc/profile.d/nix.sh ] && \\")
            write("      . ~/.nix-profile/etc/profile.d/nix.sh")
        end

        write("")
        output::info("To activate for the CURRENT session only (copy & run):")
        write("")
        write("  export PATH=\"" + bin_dir + ":$PATH\"")
        if nix_sh != "" is
            write("  . '" + nix_sh + "'")
        end

        write("")
        output::dim("Tip: run `hnm env activate --yes` to patch these files automatically.")
        write("")

        if fs::exists(bin_dir) is
            let bins: [string] = fs::list_dir(bin_dir)
            if bins.len() > 0 is
                output::dim("binaries in profile: " + str::join(bins, "  "))
            else is
                output::dim("profile/bin is empty \xe2\x80\x94 this is unexpected after install")
            end
        else is
            output::warn("profile/bin does not exist yet \xe2\x80\x94 install a package first")
        end

        write("")
        return true
    end

    fn deactivate(yes: bool) -> bool is
        output::header("Deactivate HNM profile")
        let profile: string = config::profile_dir()

        if yes is
            output::info("removing the HNM block from shell rc files...")
            write("")
            let unpatched: [string] = shellrc::unpatch()
            write("")
            if unpatched.len() == 0 is
                output::info("nothing to remove \xe2\x80\x94 no rc file had an HNM block")
            else is
                output::ok("unpatched: " + str::join(unpatched, ", "))
                output::dim("Restart your shell (or open a new terminal) to apply.")
            end
            return true
        end

        output::info("Remove this block from your ~/.bashrc or ~/.zshrc:")
        write("")
        write("  " + HNM_SHELLRC_MARKER)
        write("  export PATH=\"" + path::join(profile, "bin") + ":$PATH\"")
        write("  [ -f ... ] && . ...   # nix.sh sourcing line")
        write("")
        output::dim("Tip: run `hnm env deactivate --yes` to do this automatically.")
        write("")
        output::ok("done \xe2\x80\x94 restart your shell to apply")
        return true
    end

    fn status() -> bool is
        output::header("HNM environment status")

        let profile: string = config::profile_dir()
        let bin_dir: string = path::join(profile, "bin")

        output::label("profile dir", profile)
        output::label("bin dir", bin_dir)

        let path_var: string = env::get("PATH")
        let parts: [string] = str::split(path_var, ":")
        let mut in_path: bool = false
        let mut i: int = 0
        while i < parts.len() is
            if parts[i] == bin_dir is in_path = true end
            i = i + 1
        end
        let mut in_path_label: string = "no \xe2\x80\x94 run `hnm env activate`"
        if in_path is in_path_label = "yes \xe2\x9c\x93" end
        output::label("in PATH", in_path_label)

        let mut nix_profile_label: string = "not sourced"
        if str::index_of(path_var, ".nix-profile") >= 0 is nix_profile_label = "sourced \xe2\x9c\x93" end
        output::label("nix profile", nix_profile_label)

        let h: string = config::home()
        let rc_names: [string] = [".bashrc", ".zshrc", ".profile"]
        let mut patched_files: [string] = []
        let mut j: int = 0
        while j < rc_names.len() is
            let rc: string = rc_names[j]
            let p: string = path::join(h, rc)
            if fs::exists(p) is
                let content: string = fs::read(p)
                if str::index_of(content, HNM_SHELLRC_MARKER) >= 0 is patched_files.push(rc) end
            end
            j = j + 1
        end
        let mut patched_label: string = "none (run `hnm env activate --yes`)"
        if patched_files.len() > 0 is patched_label = str::join(patched_files, ", ") end
        output::label("rc files patched", patched_label)

        if fs::exists(bin_dir) is
            let bins: [string] = fs::list_dir(bin_dir)
            if bins.len() > 0 is
                let mut shown: [string] = []
                let mut k: int = 0
                while k < bins.len() && k < 20 is
                    shown.push(bins[k])
                    k = k + 1
                end
                output::label("binaries", str::join(shown, ", "))
            end
        end

        let default_profile_bin: string = path::join(path::join(config::home(), ".nix-profile"), "bin")
        if fs::exists(default_profile_bin) is
            output::label("~/.nix-profile/bin", "exists (may also contain packages)")
        end

        write("")
        return true
    end

end

;; ── from commands/unpack.h# ──────────────────────────────────────
;; commands/unpack.h# — HackerOS Nix Manager (H# port)
;; 1:1 port of source-code/src/commands/unpack.rs
;;
;; ADAPTATION NOTE: the original checks `libc::geteuid() == 0` for the
;; root warning. H# has no libc FFI wired up for this in the stdlib, so
;; this port shells out to the POSIX `id -u` utility instead (`0` means
;; root) — same information, no native binding needed.
;;
;; The original also runs the Nix installer with `Stdio::inherit()` so
;; its output streams live to the user's terminal. `proc_run_cmd`
;; captures output rather than inheriting stdio (see PORTING-NOTES.md),
;; so this port prints the captured installer output in full once it
;; completes, instead of it appearing live line-by-line.


mod cmd_unpack is

    fn has_bin(name: string) -> bool is
        let r = proc_run_cmd("which " + util::shell_quote(name) + " >/dev/null 2>&1", 10)
        return r.exit_code == 0
    end

    ;; H#'s `std -> os` module exposes this as a real builtin
    ;; (__builtin_os_is_root, a direct geteuid() check) — no shelling
    ;; out needed here, unlike some of this port's other adaptations.

    ;; Flat [key, val, ...] env vars for the channel-registration step
    ;; (mirrors the original's `nix_path_env`).
    fn nix_path_env() -> [string] is
        let h: string = config::home()
        let nix_bin: string = path::join(h, ".nix-profile/bin")
        let nix_store_bin: string = "/nix/var/nix/profiles/default/bin"
        let cur: string = env::get("PATH")
        return [
            "PATH", nix_bin + ":" + nix_store_bin + ":" + cur,
            "NIXPKGS_ALLOW_UNFREE", "1",
        ]
    end

    pub fn run() -> bool is
        output::header("Bootstrap Nix  (hnm unpack)")

        if os::is_root() is
            output::warn("Running as root (sudo).")
            output::dim("Nix single-user install works best as a regular user.")
            output::dim("If install fails, try: su - youruser && hnm unpack")
            write("")
        end

        ;; ── Step 1 — install Nix ─────────────────────────────────────
        if nix::nix_ok() is
            output::ok("Nix is already installed \xe2\x80\x94 skipping download")
        else is
            let mut dl: string = ""
            if has_bin("curl") is dl = "curl -fsSL https://nixos.org/nix/install"
            else is
                if has_bin("wget") is dl = "wget -qO- https://nixos.org/nix/install" end
            end

            if dl == "" is
                output::warn("Neither curl nor wget found.")
                output::dim("Install one first:")
                output::dim("  apt-get install curl   # Debian/Ubuntu")
                output::dim("  dnf install curl       # Fedora/RHEL")
                output::dim("  pacman -S curl         # Arch")
                output::error("curl/wget not found")
                return false
            end

            let task: progress::TaskProgress = progress::task(100, "installing nix")

            if os::is_root() is
                progress::warn(task, "running as root \xe2\x80\x94 Nix single-user install may have issues")
                progress::warn(task, "recommend: run `hnm unpack` as a regular user instead")
            end

            let install_sh: string = dl + " | sh -s -- --no-daemon"
            let r = proc_run_cmd(install_sh, 0)
            progress::inc(task, 80)

            if r.exit_code == 0 is
                progress::inc(task, 20)
                progress::finish_ok(task, "Nix installed")
            else is
                progress::finish_err(task, "installer exited with code " + to_string(r.exit_code))
                output::warn("Checking if nix-env works anyway...")
                proc_run_cmd(". /root/.nix-profile/etc/profile.d/nix.sh 2>/dev/null || . ~/.nix-profile/etc/profile.d/nix.sh 2>/dev/null; nix-env --version", 15)

                if !nix::nix_ok() is
                    write("")
                    output::warn("Root install failed. Recommended fix:")
                    output::dim("  1) Switch to a regular (non-root) user:")
                    output::dim("       su - youruser")
                    output::dim("  2) Run unpack as that user:")
                    output::dim("       hnm unpack")
                    output::dim("")
                    output::dim("If you MUST use root, install dependencies first:")
                    output::dim("  groupadd -r nixbld")
                    output::dim("  for i in $(seq 1 32); do")
                    output::dim("    useradd -g nixbld -G nixbld -M -N -r -s /sbin/nologin nixbld$i")
                    output::dim("  done")
                    output::dim("  Then run `hnm unpack` again.")
                    output::error("Nix installation failed")
                    return false
                end
                output::ok("nix-env works \xe2\x80\x94 continuing")
            end
        end

        ;; ── Step 2 — report nix.sh location ─────────────────────────
        let nix_sh: string = shellrc::find_nix_sh()
        if nix_sh != "" is
            output::ok("nix profile script: " + nix_sh)
        else is
            output::warn("nix.sh not found \xe2\x80\x94 you may need to open a new shell first")
        end

        ;; ── Step 3 — register nixpkgs-unstable channel ──────────────
        let env_vars: [string] = nix_path_env()
        let task2: progress::TaskProgress = progress::task(100, "registering nixpkgs channel")
        progress::log(task2, "nix-channel --add https://nixos.org/channels/nixpkgs-unstable nixpkgs")

        let add_ok: bool = progress::run_with_log_env(task2, "nix-channel",
            ["--add", "https://nixos.org/channels/nixpkgs-unstable", "nixpkgs"], env_vars)
        if !add_ok is
            progress::warn(task2, "nix-channel --add returned non-zero (may already be set)")
        end
        progress::inc(task2, 30)

        progress::set_msg(task2, "nix-channel --update")
        progress::log(task2, "nix-channel --update")
        let ok: bool = progress::run_with_log_env(task2, "nix-channel", ["--update"], env_vars)
        progress::inc(task2, 70)

        if ok is
            progress::finish_ok(task2, "nixpkgs-unstable channel registered")
        else is
            progress::finish_err(task2, "nix-channel --update failed")
            output::dim("Check internet connection, then run `hnm unpack` again.")
            return false
        end

        ;; ── Step 4 — patch shell rc files ───────────────────────────
        write("")
        output::info("Patching shell RC files...")
        shellrc::patch(path::join(config::profile_dir(), "bin"))

        ;; ── Done ─────────────────────────────────────────────────────
        write("")
        output::ok("Nix is ready!")
        write("")
        output::info("Reload your shell:")
        write("  source ~/.bashrc    # bash")
        write("  source ~/.zshrc     # zsh")
        write("  exec $SHELL         # any shell")
        write("")
        output::dim("Verify:          hnm check")
        output::dim("Build pkg index: hnm update   (run once, takes ~2 min)")
        output::dim("Search:          hnm search <package>")

        return true
    end

end

