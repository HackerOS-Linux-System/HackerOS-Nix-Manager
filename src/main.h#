mod cmd_update is

    pub fn run(packages: [string]) -> bool is
        if !nix::ensure_nix() is return false end
        output::header("Update HNM")

        ;; ── Step 1: refresh nixpkgs channel ─────────────────────────
        let task1: progress::TaskProgress = progress::task(100, "refreshing nixpkgs channel")
        if !nix::update_channel(task1) is return false end
        progress::finish_ok(task1, "channel refreshed")
        write("")

        ;; ── Step 2: rebuild local package index ─────────────────────
        let task2: progress::TaskProgress = progress::task(100, "building local package index...")
        progress::log(task2, "streaming nix-env -qaP \xe2\x86\x92 ~/.local/share/hnm/pkgdb.tsv")
        progress::log(task2, "this takes 1-2 minutes on first run, ~30s on subsequent runs")

        let count: int = pkgdb::rebuild_db(
            |msg: string| is progress::log(task2, msg) end,
            |msg: string| is progress::err_line(task2, msg) end,
        )

        if count >= 0 is
            progress::inc(task2, 100)
            progress::finish_ok(task2, "indexed " + to_string(count) + " packages")
        else is
            progress::finish_err(task2, "package index build failed")
            output::warn("package index build failed \xe2\x80\x94 search may not work")
            output::dim("Try: hnm unpack  (to ensure nixpkgs channel is registered)")
        end
        write("")

        ;; ── Step 3: upgrade installed packages (one at a time) ──────
        let tracked: [state::InstalledPkg] = state::list()

        if tracked.len() == 0 is
            output::dim("no packages installed \xe2\x80\x94 nothing to upgrade")
        else is
            let explicit: bool = packages.len() > 0
            let mut to_upgrade: [state::InstalledPkg] = []
            let mut i: int = 0
            while i < tracked.len() is
                let mut wanted: bool = !explicit
                if explicit is
                    let mut j: int = 0
                    while j < packages.len() is
                        if packages[j] == tracked[i].name is wanted = true end
                        j = j + 1
                    end
                end
                if wanted is to_upgrade.push(tracked[i]) end
                i = i + 1
            end

            let mut pinned: [state::InstalledPkg] = []
            let mut unpinned: [state::InstalledPkg] = []
            let mut k: int = 0
            while k < to_upgrade.len() is
                if to_upgrade[k].pinned != "" is pinned.push(to_upgrade[k]) else is unpinned.push(to_upgrade[k]) end
                k = k + 1
            end
            to_upgrade = unpinned

            let mut pi: int = 0
            while pi < pinned.len() is
                let mut pv: string = "?"
                if pinned[pi].pinned != "" is pv = pinned[pi].pinned end
                output::warn("skipping '" + pinned[pi].name + "' \xe2\x80\x94 pinned to " + pv)
                pi = pi + 1
            end

            if to_upgrade.len() > 0 is
                output::info("upgrading " + to_string(to_upgrade.len()) + " package(s) one at a time...")
                write("")

                let total: int = to_upgrade.len()
                let mut upgraded: int = 0
                let mut failed_pkgs: [string] = []

                let mut ui: int = 0
                while ui < total is
                    let pkg: state::InstalledPkg = to_upgrade[ui]
                    output::step(to_string(ui + 1) + "/" + to_string(total), "upgrading  " + pkg.name)
                    let task3: progress::TaskProgress = progress::task(100, "nix-env -uA nixpkgs." + pkg.name)
                    let ok: bool = nix::upgrade_one(pkg.name, task3)
                    progress::inc(task3, 90)
                    if ok is
                        progress::inc(task3, 10)
                        progress::finish_ok(task3, pkg.name + " upgraded")
                        upgraded = upgraded + 1
                    else is
                        progress::finish_err(task3, "upgrade failed")
                        failed_pkgs.push(pkg.name)
                    end
                    write("")
                    ui = ui + 1
                end

                output::header("Update summary")
                output::label("upgraded", to_string(upgraded))
                output::label("failed", to_string(failed_pkgs.len()))
                if pinned.len() > 0 is
                    output::label("skipped (pinned)", to_string(pinned.len()))
                end
                if failed_pkgs.len() > 0 is
                    write("")
                    output::warn("failed: " + str::join(failed_pkgs, ", "))
                end
            end
        end

        let mut st: state::State = state::load()
        st.last_update = time::now_unix()
        state::save(st)

        let gen: int = nix::current_generation()
        if gen >= 0 is state::set_generation(gen) end

        let cfg: config::HnmConfig = config::load()
        if cfg.max_generations > 0 is
            let task4: progress::TaskProgress = progress::task(1, "pruning old generations")
            let n: int = nix::prune_old_generations(cfg.max_generations, task4)
            if n > 0 is
                output::dim("pruned " + to_string(n) + " old generation(s) (max_generations = " + to_string(cfg.max_generations) + ")")
            end
        end
        if cfg.auto_gc is
            output::info("auto_gc is enabled in config.hk \xe2\x80\x94 running `hnm gc`...")
            let task5: progress::TaskProgress = progress::task(100, "nix-store --gc")
            nix::gc(task5)
        end

        write("")
        output::ok("HNM is up to date")
        return true
    end

end

;; ── from commands/upgrade.h# ──────────────────────────────────────
;; commands/upgrade.h# — HackerOS Nix Manager (H# port)
;; 1:1 port of source-code/src/commands/upgrade.rs — self-update from
;; GitHub releases.
;;
;; ADAPTATION NOTE: no `sudo`-status-aware exec here beyond shelling
;; out exactly like the original did — `sudo rm`/`sudo mv` still run
;; via `proc_run_cmd`, so an interactive sudo password prompt (if the
;; user's sudo isn't passwordless / recently authenticated) will not
;; have a terminal to prompt on, the same practical caveat the
;; original's `Stdio`-inherited `Command::status()` calls didn't fully
;; solve either — both rely on the environment's sudo cache.


    "https://raw.githubusercontent.com/HackerOS-Linux-System/HackerOS-Nix-Manager/main/version.hacker"
    "https://github.com/HackerOS-Linux-System/HackerOS-Nix-Manager/releases/download"

mod cmd_upgrade is

    fn local_version_file() -> string is
        return path::join(path::join(path::join(config::home(), ".hackeros"), "hnm"), "version.hacker")
    end

    fn tmp_version_file() -> string is
        return path::join(os::temp_dir(), ".hnm_upstream_version.hacker")
    end

    ;; version.hacker format:
    ;; [
    ;;   0.1
    ;; ]
    fn parse_version(content: string) -> string is
        let lines: [string] = str::split(content, "\n")
        let mut i: int = 0
        while i < lines.len() is
            let mut t: string = str::trim(lines[i])
            t = str::replace_all(t, "[", "")
            t = str::replace_all(t, "]", "")
            t = str::trim(t)
            if t != "" is
                let mut all_ok: bool = true
                let mut j: int = 0
                while j < t.len() is
                    let c: string = t[j..j + 1]
                    if !str::is_numeric(c) && c != "." is all_ok = false end
                    j = j + 1
                end
                if all_ok is return t end
            end
            i = i + 1
        end
        return ""
    end

    fn version_part(s: string, idx: int) -> int is
        let parts: [string] = str::split(s, ".")
        if idx >= parts.len() is return 0 end
        if !str::is_numeric(parts[idx]) is return 0 end
        return conv::str_to_int(parts[idx])
    end

    fn version_greater(upstream: string, local: string) -> bool is
        let up: [string] = str::split(upstream, ".")
        let lo: [string] = str::split(local, ".")
        let mut max_len: int = up.len()
        if lo.len() > max_len is max_len = lo.len() end

        let mut i: int = 0
        while i < max_len is
            let ui: int = version_part(upstream, i)
            let li: int = version_part(local, i)
            if ui > li is return true end
            if ui < li is return false end
            i = i + 1
        end
        return false
    end

    fn curl_download(url: string, dest: string, task: progress::TaskProgress) -> bool is
        progress::log(task, "curl -fsSL " + url + " -o " + dest)
        let cmd: string = util::build_shell_cmd("curl", ["-fsSL", url, "-o", dest], [])
        let r = proc_run_cmd(cmd, 120)
        if r.exit_code != 0 is return false end
        return true
    end

    pub fn run() -> bool is
        output::header("HNM Self-Upgrade")

        ;; ── 1. Read local version ────────────────────────────────────
        let local_ver_path: string = local_version_file()
        let mut local_version: string = ""
        if fs::exists(local_ver_path) is
            let content: string = fs::read(local_ver_path)
            local_version = parse_version(content)
            if local_version == "" is
                output::error("cannot parse local version file at " + local_ver_path)
                return false
            end
        else is
            local_version = HNM_VERSION
            output::warn("local version file not found at " + local_ver_path + " \xe2\x80\x94 creating with version " + local_version)
            fs::mkdir(path::parent(local_ver_path))
            fs::write(local_ver_path, "[\n  " + local_version + "\n]\n")
        end

        output::label("current version", local_version)

        ;; ── 2. Download upstream version.hacker ─────────────────────
        let task: progress::TaskProgress = progress::task(100, "checking for updates...")
        progress::log(task, "fetching " + HNM_UPSTREAM_VERSION_URL)

        let tmp: string = tmp_version_file()
        let dl_ok: bool = curl_download(HNM_UPSTREAM_VERSION_URL, tmp, task)
        progress::inc(task, 50)

        if !dl_ok is
            progress::finish_err(task, "download failed")
            output::warn("Could not reach GitHub \xe2\x80\x94 check your internet connection.")
            output::error("cannot check for updates")
            return false
        end
        progress::finish_ok(task, "version info fetched")

        ;; ── 3. Parse upstream version ────────────────────────────────
        let upstream_content: string = fs::read(tmp)
        fs::remove(tmp)

        let upstream_version: string = parse_version(upstream_content)
        if upstream_version == "" is
            output::error("cannot parse upstream version.hacker")
            return false
        end

        output::label("latest version", upstream_version)

        ;; ── 4. Compare ───────────────────────────────────────────────
        if !version_greater(upstream_version, local_version) is
            write("")
            output::ok("HNM is up to date  (v" + local_version + ")")
            return true
        end

        write("")
        output::info("New version available: " + local_version + " \xe2\x86\x92 " + upstream_version)
        write("")

        ;; ── 5. Download new binary ───────────────────────────────────
        let download_url: string = HNM_UPSTREAM_RELEASE_URL + "/v" + upstream_version + "/hnm"
        let tmp_bin: string = path::join(os::temp_dir(), ".hnm_upgrade_bin")

        let task2: progress::TaskProgress = progress::task(100, "downloading hnm v" + upstream_version)
        progress::log(task2, "curl -fsSL " + download_url + " -o " + tmp_bin)
        let dl2_ok: bool = curl_download(download_url, tmp_bin, task2)
        progress::inc(task2, 70)

        if !dl2_ok is
            progress::finish_err(task2, "download failed")
            output::error("failed to download new binary")
            return false
        end
        progress::inc(task2, 30)
        progress::finish_ok(task2, "binary downloaded")

        ;; ── 6. chmod +x ──────────────────────────────────────────────
        let chmod_r = proc_run_cmd("chmod a+x " + util::shell_quote(tmp_bin), 10)
        if chmod_r.exit_code != 0 is
            output::error("chmod a+x failed on downloaded binary")
            return false
        end

        ;; ── 7. sudo mv to /usr/bin/hnm ─────────────────────────────
        output::info("Installing to /usr/bin/hnm  (requires sudo)...")

        let task3: progress::TaskProgress = progress::task(100, "installing to /usr/bin/hnm")
        progress::log(task3, "sudo rm -rf /usr/bin/hnm")
        let rm_r = proc_run_cmd("sudo rm -rf /usr/bin/hnm", 30)
        if rm_r.exit_code != 0 is
            progress::finish_err(task3, "sudo rm /usr/bin/hnm failed")
            output::error("failed to remove old /usr/bin/hnm \xe2\x80\x94 do you have sudo?")
            return false
        end
        progress::inc(task3, 30)

        progress::log(task3, "sudo mv " + tmp_bin + " /usr/bin/hnm")
        let mv_r = proc_run_cmd("sudo mv " + util::shell_quote(tmp_bin) + " /usr/bin/hnm", 30)
        if mv_r.exit_code != 0 is
            progress::finish_err(task3, "sudo mv failed")
            output::error("failed to move binary to /usr/bin/hnm")
            return false
        end
        progress::inc(task3, 70)
        progress::finish_ok(task3, "hnm v" + upstream_version + " installed to /usr/bin/hnm")

        ;; ── 8. Update local version file ────────────────────────────
        fs::write(local_ver_path, "[\n  " + upstream_version + "\n]\n")

        write("")
        output::ok("HNM upgraded  v" + local_version + "  \xe2\x86\x92  v" + upstream_version)
        output::dim("Run `hnm version` to confirm.")

        return true
    end

end

;; ─── entry point ─────────────────────────────────────────────────────
;; 1:1 port of source-code/src/main.rs's dispatch table.

fn main() is
    let cmd: cliapp::CliCommand = cliapp::parse()
    let mut ok: bool = true

    if cmd.kind == "__exit_ok" is return end
    if cmd.kind == "error"     is output::error(cmd.error_msg) ; ok = false end
    if cmd.kind == "help"      is cliapp::print_help() end
    if cmd.kind == "version"   is output::version_info() end
    if cmd.kind == "search"    is ok = cmd_search::run(cmd.query, cmd.json) end
    if cmd.kind == "install"   is ok = cmd_install::run(cmd.packages, cmd.no_env) end
    if cmd.kind == "remove"    is ok = cmd_remove::run(cmd.packages, cmd.force) end
    if cmd.kind == "update"    is ok = cmd_update::run(cmd.packages) end
    if cmd.kind == "upgrade"   is ok = cmd_upgrade::run() end
    if cmd.kind == "unpack"    is ok = cmd_unpack::run() end
    if cmd.kind == "check"     is ok = cmd_check::run() end
    if cmd.kind == "info"      is ok = cmd_info::run(cmd.package) end
    if cmd.kind == "list"      is ok = cmd_list::run(cmd.installed, cmd.json) end
    if cmd.kind == "env"       is ok = cmd_env::run(cmd.sub, cmd.yes) end
    if cmd.kind == "doctor"    is ok = cmd_doctor::run() end
    if cmd.kind == "clean"     is ok = cmd_clean::run() end
    if cmd.kind == "rollback"  is ok = cmd_rollback::run(cmd.generation) end
    if cmd.kind == "pin"       is ok = cmd_pin::run(cmd.package, cmd.version_arg) end
    if cmd.kind == "unpin"     is ok = cmd_unpin::run(cmd.package) end
    if cmd.kind == "which"     is ok = cmd_which::run(cmd.package) end
    if cmd.kind == "gc"        is ok = cmd_gc::run() end

    if !ok is
        exit(1)
    end
end
