use "std -> fs"      from "fs"
use "std -> path"    from "path"
use "std -> env"     from "env"
use "std -> strings" from "str"

mod cmd_env is

    pub fn run(sub: string, yes: bool) -> bool is
        if sub == "activate"   is return activate(yes) end
        if sub == "deactivate" is return deactivate(yes) end
        if sub == "status"     is return status() end
        output::error("unknown env subcommand '" + sub + "' \xe2\x80\x94 use activate | deactivate | status")
        return false
    end

    fn activate(yes: bool) -> bool is
        output::header("Activate HNM profile")

        let profile: string = config::profile_dir()
        let bin_dir: string = path::join(profile, "bin")

        if yes is
            output::info("patching shell rc files (~/.bashrc, ~/.zshrc, ~/.profile)...")
            write("")
            let patched: [string] = shellrc::patch(bin_dir)
            write("")
            if patched.len() == 0 is
                output::info("nothing to patch \xe2\x80\x94 already activated, or no rc files found")
            else is
                output::ok("patched: " + str::join(patched, ", "))
                output::dim("Reload your shell (or open a new terminal) to apply.")
            end
            return true
        end

        output::info("Add the following to your ~/.bashrc or ~/.zshrc:")
        write("")
        write("  # HNM + Nix")
        write("  export PATH=\"" + bin_dir + ":$PATH\"")

        let nix_sh: string = shellrc::find_nix_sh()
        if nix_sh != "" is
            write("  [ -f '" + nix_sh + "' ] && . '" + nix_sh + "'")
        else is
            write("  [ -f ~/.nix-profile/etc/profile.d/nix.sh ] && \\")
            write("      . ~/.nix-profile/etc/profile.d/nix.sh")
        end

        write("")
        output::info("To activate for the CURRENT session only (copy & run):")
        write("")
        write("  export PATH=\"" + bin_dir + ":$PATH\"")
        if nix_sh != "" is
            write("  . '" + nix_sh + "'")
        end

        write("")
        output::dim("Tip: run `hnm env activate --yes` to patch these files automatically.")
        write("")

        if fs::exists(bin_dir) is
            let bins: [string] = fs::list_dir(bin_dir)
            if bins.len() > 0 is
                output::dim("binaries in profile: " + str::join(bins, "  "))
            else is
                output::dim("profile/bin is empty \xe2\x80\x94 this is unexpected after install")
            end
        else is
            output::warn("profile/bin does not exist yet \xe2\x80\x94 install a package first")
        end

        write("")
        return true
    end

    fn deactivate(yes: bool) -> bool is
        output::header("Deactivate HNM profile")
        let profile: string = config::profile_dir()

        if yes is
            output::info("removing the HNM block from shell rc files...")
            write("")
            let unpatched: [string] = shellrc::unpatch()
            write("")
            if unpatched.len() == 0 is
                output::info("nothing to remove \xe2\x80\x94 no rc file had an HNM block")
            else is
                output::ok("unpatched: " + str::join(unpatched, ", "))
                output::dim("Restart your shell (or open a new terminal) to apply.")
            end
            return true
        end

        output::info("Remove this block from your ~/.bashrc or ~/.zshrc:")
        write("")
        write("  " + HNM_SHELLRC_MARKER)
        write("  export PATH=\"" + path::join(profile, "bin") + ":$PATH\"")
        write("  [ -f ... ] && . ...   # nix.sh sourcing line")
        write("")
        output::dim("Tip: run `hnm env deactivate --yes` to do this automatically.")
        write("")
        output::ok("done \xe2\x80\x94 restart your shell to apply")
        return true
    end

    fn status() -> bool is
        output::header("HNM environment status")

        let profile: string = config::profile_dir()
        let bin_dir: string = path::join(profile, "bin")

        output::label("profile dir", profile)
        output::label("bin dir", bin_dir)

        let path_var: string = env::get("PATH")
        let parts: [string] = str::split(path_var, ":")
        let mut in_path: bool = false
        let mut i: int = 0
        while i < parts.len() is
            if parts[i] == bin_dir is in_path = true end
            i = i + 1
        end
        let mut in_path_label: string = "no \xe2\x80\x94 run `hnm env activate`"
        if in_path is in_path_label = "yes \xe2\x9c\x93" end
        output::label("in PATH", in_path_label)

        let mut nix_profile_label: string = "not sourced"
        if str::index_of(path_var, ".nix-profile") >= 0 is nix_profile_label = "sourced \xe2\x9c\x93" end
        output::label("nix profile", nix_profile_label)

        let h: string = config::home()
        let rc_names: [string] = [".bashrc", ".zshrc", ".profile"]
        let mut patched_files: [string] = []
        let mut j: int = 0
        while j < rc_names.len() is
            let rc: string = rc_names[j]
            let p: string = path::join(h, rc)
            if fs::exists(p) is
                let content: string = fs::read(p)
                if str::index_of(content, HNM_SHELLRC_MARKER) >= 0 is patched_files.push(rc) end
            end
            j = j + 1
        end
        let mut patched_label: string = "none (run `hnm env activate --yes`)"
        if patched_files.len() > 0 is patched_label = str::join(patched_files, ", ") end
        output::label("rc files patched", patched_label)

        if fs::exists(bin_dir) is
            let bins: [string] = fs::list_dir(bin_dir)
            if bins.len() > 0 is
                let mut shown: [string] = []
                let mut k: int = 0
                while k < bins.len() && k < 20 is
                    shown.push(bins[k])
                    k = k + 1
                end
                output::label("binaries", str::join(shown, ", "))
            end
        end

        let default_profile_bin: string = path::join(path::join(config::home(), ".nix-profile"), "bin")
        if fs::exists(default_profile_bin) is
            output::label("~/.nix-profile/bin", "exists (may also contain packages)")
        end

        write("")
        return true
    end

end
